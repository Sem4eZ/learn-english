PORT=3001
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Gemini Models Pipeline (comma-separated prioritized fallback chain)
GEMINI_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite,gemini-flash-latest,gemini-2.5-flash

# Optional: Turso Serverless Cloud libSQL Database (for persistent cloud storage on Render)
# If omitted, server automatically falls back to local SQLite in ./data/english_mastery.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional local SQLite database path
DATABASE_PATH=./data/english_mastery.db
