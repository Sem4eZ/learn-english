{
  "name": "lexiflow-server",
  "version": "1.0.0",
  "description": "LexiFlow AI-powered English Learning backend with Gemini API and native SQLite",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --import ./tests/setup.js --test --test-concurrency=1 tests/*.test.js",
    "test:watch": "node --import ./tests/setup.js --test --watch tests/*.test.js",
    "test:cron": "node scripts/run-tests-cron.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
